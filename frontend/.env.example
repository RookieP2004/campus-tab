# Front-end build settings. Only VITE_* values reach the browser, so never put
# secrets here. Always use 127.0.0.1 (not localhost) for local hosts.
VITE_API_BASE_URL=/api/v1
VITE_REVERB_APP_KEY=campus-tab-local-key
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
# Set to false to turn the notification socket off (the bell then polls every 60 s).
VITE_REVERB_ENABLED=true
