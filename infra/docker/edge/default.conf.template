# The web app as production serves it (Phase 9): the Vite production build
# from frontend/dist with the security headers, and /api proxied to the API
# so the session cookie stays on one origin. Locally it runs as the `edge`
# service (profile "edge"), which the ZAP baseline scan targets.
#
# ${CONNECT_EXTRA}: where pages may also connect, i.e. the Reverb socket
# (ws://127.0.0.1:8080 locally, wss://<host> in production).

server_tokens off;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 12m;

    # Hashed build files: cache for a year.
    location /assets/ {
        try_files $uri =404;
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # The API answers with its own headers.
    location ~ ^/(api|sanctum)/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Powered-By;
    }

    # Every other path is a screen of the single-page app.
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
    }

    error_page 404 /index.html;
}
