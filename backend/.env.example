APP_NAME="Campus TAB"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MongoDB 8 running as a single-node replica set (see infra/docker-compose.yml).
DB_CONNECTION=mongodb
MONGODB_URI="mongodb://mongo:27017/?replicaSet=rs0"
MONGODB_DATABASE=campus_tab

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit catches every email in development: http://127.0.0.1:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@campustab.local"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb (WebSockets). Development values only; generate new ones per environment.
REVERB_APP_ID=campus-tab-local
REVERB_APP_KEY=campus-tab-local-key
REVERB_APP_SECRET=campus-tab-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Licence keys. Fill these with: php artisan licence:keygen --write
# Never commit real values. Changing them invalidates every issued licence.
LICENCE_KEY_PEPPER=
LICENCE_SIGNING_SECRET_KEY=
LICENCE_SIGNING_PUBLIC_KEY=
LICENCE_GRACE_DAYS=15

# Text messages (OTP): log writes them to storage/logs (development).
SMS_DRIVER=log

# Tenant query guard: log (development), record (tests), off.
TENANCY_QUERY_GUARD=log

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
